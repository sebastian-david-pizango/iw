<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= modo === 'crear' ? 'Nueva Universidad' : 'Editar Universidad' %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="contenedor contenedor-form">
        <h1><%= modo === 'crear' ? 'Agregar Universidad' : 'Editar Universidad' %></h1>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alerta alerta-error"><%= error %></div>
        <% } %>

        <form
            method="POST"
            action="<%= modo === 'crear' ? '/universidades' : '/editar/' + universidad.id %>"
            class="formulario"
        >
            <label for="nombre">Nombre de la Universidad</label>
            <input
                type="text"
                id="nombre"
                name="nombre"
                required
                value="<%= universidad ? universidad.nombre : '' %>"
            >

            <label for="fecha">Fecha de Licenciamiento</label>
            <input
                type="date"
                id="fecha"
                name="fecha"
                required
                value="<%= universidad ? universidad.fecha : '' %>"
            >

            <label for="resolucion">Resolución (1 a 5)</label>
            <select id="resolucion" name="resolucion" required>
                <% for (let i = 1; i <= 5; i++) { %>
                    <option value="<%= i %>" <%= universidad && Number(universidad.resolucion) === i ? 'selected' : '' %>>
                        <%= i %>
                    </option>
                <% } %>
            </select>

            <label for="departamento">Departamento</label>
            <input
                type="text"
                id="departamento"
                name="departamento"
                required
                value="<%= universidad ? universidad.departamento : '' %>"
            >

            <label for="provincia">Provincia</label>
            <input
                type="text"
                id="provincia"
                name="provincia"
                required
                value="<%= universidad ? universidad.provincia : '' %>"
            >

            <label for="tipoGestion">Tipo de Gestión</label>
            <select id="tipoGestion" name="tipoGestion" required>
                <option value="">-- Seleccione --</option>
                <option value="Pública" <%= universidad && universidad.tipoGestion === 'Pública' ? 'selected' : '' %>>Pública</option>
                <option value="Privada" <%= universidad && universidad.tipoGestion === 'Privada' ? 'selected' : '' %>>Privada</option>
            </select>

            <div class="acciones-form">
                <button type="submit" class="btn-guardar">
                    <%= modo === 'crear' ? 'Agregar' : 'Guardar cambios' %>
                </button>
                <a href="/" class="btn-cancelar">Cancelar</a>
            </div>
        </form>
    </div>
</body>
</html>
